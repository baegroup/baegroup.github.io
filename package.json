{
  "name": "baelab-site",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "content:build": "node scripts/build-content.mjs && node scripts/build-publication-covers.mjs && node scripts/build-brand-assets.mjs",
    "images:optimize:news": "node scripts/optimize-news-images.mjs",
    "news:sync:notion": "node scripts/sync-news-from-notion.mjs",
    "team:sync:notion": "node scripts/sync-team-from-notion.mjs",
    "publications:sync:notion": "node scripts/sync-publications-from-notion.mjs",
    "notion:push:site-data": "node scripts/push-site-data-to-notion.mjs",
    "analytics:sync:notion": "node scripts/sync-analytics-to-notion.mjs",
    "cms:sync:notion": "npm run news:sync:notion && npm run team:sync:notion && npm run publications:sync:notion",
    "publish": "node scripts/publish-content.mjs",
    "publish:cms": "npm run cms:sync:notion && npm run publish",
    "publish:dry": "node scripts/publish-content.mjs --dry-run",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "audit:live": "node scripts/audit-live-site.mjs",
    "check": "node scripts/validate-site.mjs",
    "predev": "npm run content:build",
    "prebuild": "npm run content:build",
    "dev": "vite",
    "build": "vite build && node scripts/build-route-html.mjs && node scripts/prerender-routes.mjs && node scripts/validate-dist-links.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.16",
    "vite": "^8.2.1"
  },
  "overrides": {
    "js-yaml": "3.15.1"
  }
}
